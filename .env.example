# ── Enyd Arch · environment template ────────────────────────────────────────
# Copy to `.env.local` and replace every value before any real deployment.

# PostgreSQL connection string
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/enyd_arch

# Random secret, minimum 32 characters. Rotating this invalidates all sessions.
AUTH_SECRET=

# Canonical origin. Sessions and CSRF tokens are bound to this exact origin.
APP_ORIGIN=http://localhost:3000

# Separate origin dedicated to member-uploaded games. Must differ from
# APP_ORIGIN so untrusted code can never touch the application's origin.
ARCH_GAME_ORIGIN=http://localhost:3101

# Object storage. "local" writes to ./storage, "s3" uses the S3 provider.
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Upload policy
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_BYTES=12582912

# Optional external malware scanner (ClamAV over TCP or a unix socket).
# Uploads are quarantined in `quarantine/` until a clean verdict is returned.
MALWARE_SCANNER_URL=
MALWARE_SCANNER_TOKEN=

# Trust proxy hops for accurate client IPs behind a load balancer.
# Set to 0 when running without a proxy so the socket address is used.
TRUST_PROXY_HOPS=0

SANDBOX_PORT=3101
SANDBOX_SECRET=

